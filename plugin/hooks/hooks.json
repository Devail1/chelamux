{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${CHELA_WID:-}\" ] && curl -s --fail --max-time 1 -X POST -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:5001/hooks/PreToolUse 2>/dev/null || true",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${CHELA_WID:-}\" ] && curl -s --fail --max-time 1 -X POST -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:5001/hooks/PostToolUse 2>/dev/null || true",
            "timeout": 2
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${CHELA_WID:-}\" ] && curl -s --fail --max-time 118 -X POST -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:5001/hooks/PermissionRequest 2>/dev/null || true",
            "timeout": 120
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${CHELA_WID:-}\" ] && curl -s --fail --max-time 1 -X POST -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:5001/hooks/PermissionDenied 2>/dev/null || true",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:5001/hooks/UserPromptSubmit",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${CHELA_WID:-}\" ] && curl -s --fail --max-time 3 -X POST -H 'Content-Type: application/json' -H \"X-Chela-Wid: ${CHELA_WID:-}\" --data-binary @- http://127.0.0.1:5001/hooks/SessionStart 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:5001/hooks/SessionEnd",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:5001/hooks/Stop",
            "timeout": 2
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${CHELA_WID:-}\" ] && curl -s --fail --max-time 1 -X POST -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:5001/hooks/MessageDisplay 2>/dev/null || true",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:5001/hooks/SubagentStart",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:5001/hooks/SubagentStop",
            "timeout": 2
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:5001/hooks/Notification",
            "timeout": 2
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:5001/hooks/PreCompact",
            "timeout": 2
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:5001/hooks/PostCompact",
            "timeout": 2
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:5001/hooks/Elicitation",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
