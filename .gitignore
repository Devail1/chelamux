# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.eggs/

# chela runtime state
.chela/
*.db

# OKF knowledge bundle — LOCAL fleet data, never committed (docs/OKF.md → Security)
knowledge/
*.okf/

# Cloudflare Wrangler local cache (holds account_id; deploy-only, not source)
.wrangler/

# secrets / credentials — never commit
.env
.env.*
*.cred
*.pem
*.key
*.p12
secrets.*
*_token
*.secret

# OS / editor
.DS_Store
*.swp

# Claude Code session/local state
.claude/

# Private scope doc — must NEVER be committed (autonomous agents run `git add`;
# without this line one `git add -A` would publish it). See CLAUDE.md.
docs/AUTH_PLANE_SCOPE.md

# Node — dev-only (jsdom, for the dashboard DOM test suites). See package.json. No trailing
# slash: CMX-151 makes this a SYMLINK (into a shared install outside any worktree), and a
# `dir/`-style pattern does not match a symlink named `node_modules`.
node_modules

# The dispatch queue is per-install working state, not shipped content
# (see TODO.example.md). The dispatcher reads it from disk.
TODO.md

# `chela task-finished --self-check-experiments` scratch files (WORKFLOW.md step 6) —
# throwaway experiment logs, not source. WORKFLOW.md never mandates a filename, so agents
# invent one per run; match the CONVENTION (self-check / scratch + experiments), not one
# literal spelling — the old `.chela-self-check-*.json`-only rule caught 2 of the 4 spellings
# actually committed: .chela-self-check-cmx280.json, .chela-self-check-cmx284.json,
# scratch_cmx288_experiments.json, self_check_experiments.json (see d77c2c4),
# .chela_selfcheck_cmx337_round3.json (see docs/defeat_shapes/337, round 5).
.chela-self-check-*.json
*self[-_]check*.json
*selfcheck*.json
*scratch*experiment*.json

# `chela judge` scratch file — `chela.judge.experiments_path()` always writes this exact
# literal name inside the judge's own throwaway worktree, so unlike the self-check files
# above there's no spelling variance to glob for. Reached a branch on cmx-314/PR #392
# (same class as the self-check leak fixed in d77c2c4 via CMX-282): a tracked copy makes
# the judge's worktree dirty the moment it starts, so it refuses to run at all.
.chela-judge-experiments.json
