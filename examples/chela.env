# chela.env — the single source of truth for a chela install's config.
#
#   cp examples/chela.env ~/.chela/chela.env      # then edit
#
# Sourced by chela itself (chela/config.py, at import) and by scripts/run-chela.sh,
# which is what PM2/systemd should start. Nothing else should carry a copy of these
# values: a process manager's `env:` block is a second place for config to live, and a
# second place is where drift comes from. `chela doctor` compares the two and complains.
#
# An exported variable BEATS this file, so a one-off `CHELA_TMUX_SESSION=other chela
# status` still works. Every line here is optional — chela runs on documented defaults
# with an empty file, or with no file at all.
#
# NO SECRETS. Put TELEGRAM_BOT_TOKEN and friends in ~/.chela/secrets.env (chmod 600);
# run-chela.sh sources that separately. This file is meant to be pasteable.

# The tmux session chela orchestrates. Default: chela.
CHELA_TMUX_SESSION=chela

# NOTE: CHELA_DIR is *not* set here. This file is FOUND via $CHELA_DIR, so it cannot
# move itself — export it in the environment (run-chela.sh does) if you want it
# somewhere other than ~/.chela. `chela doctor` errors if this file sets it anyway.

# Dashboard bind. The port is also what the Claude Code hooks plugin POSTs to, so it has
# to be the same number in every process — that is the whole reason this file exists.
# Prefer changing it here over `chela dashboard --port`, which is a per-process override
# that nothing else can see (the dashboard publishes what it really bound to
# $CHELA_DIR/dashboard.port so `chela plugin` stays right either way).
CHELA_DASH_HOST=127.0.0.1
CHELA_DASHBOARD_PORT=5001

# Embedded ttyd terminal wall. It serves writable shells: leave EXPOSE off unless the
# dashboard is behind a tailnet / SSH tunnel and you know what you are doing.
CHELA_TERMINALS_ENABLED=true
CHELA_TERMINALS_EXPOSE=false

# Window names to hide from discovery (placeholder / keep-alive windows), comma-separated.
# CHELA_IGNORE_WINDOWS=__main__

# Work-item dispatcher inside the daemon: colon-separated WORKFLOW.md paths. Empty = off.
# CHELA_DISPATCH_WORKFLOWS=/path/to/repo/WORKFLOW.md
